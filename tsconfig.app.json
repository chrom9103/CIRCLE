{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.d.ts",
    "frontend/src/**/*.vue",
    "frontend/src/**/*.tsx",
    "frontend/src/**/*.jsx"
  ],
  "exclude": ["frontend/src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["frontend/src/*"]
    }
  }
}